# Copy this file to .env and fill in real values
# NEVER commit .env to git

OPENAI_API_KEY=sk-proj-your_openai_key_here

# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS

# Seeder credentials (optional — used by seeder.py only)
SEED_MASTER_PASSWORD=Master@1234
SEED_ADVANCE_PASSWORD=Advance@1234
SEED_STUDENT_PASSWORD=Student@1234

# Production CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:4200
